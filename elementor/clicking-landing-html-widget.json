{"version": "0.4", "title": "דף נחיתה – קליקינג (HTML)", "type": "page", "page_settings": {"template": "elementor_canvas"}, "content": [{"id": "a1b2c3d", "elType": "container", "isInner": false, "settings": {"content_width": "full", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "e4f5a6b", "elType": "widget", "widgetType": "html", "settings": {"html": "<link href=\"https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;700;800;900&display=swap\" rel=\"stylesheet\">\n<div class=\"ck-lp\" dir=\"rtl\">\n<style>\n  :root{\n    --orange:#f29f05;\n    --orange-dark:#d98a00;\n    --orange-soft:#fff4e0;\n    --gray-900:#2b2b2b;\n    --gray-700:#535353;\n    --gray-500:#7a7a7a;\n    --gray-200:#e6e6e6;\n    --gray-100:#f4f4f4;\n    --white:#fff;\n    --radius:18px;\n    --shadow:0 18px 50px rgba(43,43,43,.12);\n  }\n  *{box-sizing:border-box;margin:0;padding:0}\n  html{scroll-behavior:smooth}\n  body{font-family:\"Heebo\",system-ui,sans-serif;color:var(--gray-900);background:var(--white);line-height:1.6;font-size:17px;overflow-x:hidden}\n  img{max-width:100%;display:block}\n  a{color:inherit}\n  .wrap{width:min(1140px,100% - 32px);margin-inline:auto}\n  .accent{color:var(--orange)}\n\n  /* Buttons */\n  .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;cursor:pointer;font:inherit;font-weight:700;\n       background:var(--orange);color:var(--gray-900);padding:15px 28px;border-radius:999px;text-decoration:none;font-size:1.05rem;\n       box-shadow:0 10px 24px rgba(242,159,5,.35);transition:transform .15s,background .15s,box-shadow .15s}\n  .btn:hover{background:var(--orange-dark);transform:translateY(-2px);box-shadow:0 14px 30px rgba(242,159,5,.45)}\n  .btn:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible{outline:3px solid var(--gray-900);outline-offset:3px}\n  .btn-ghost{background:transparent;color:var(--white);box-shadow:inset 0 0 0 2px rgba(255,255,255,.4)}\n  .btn-ghost:hover{background:rgba(255,255,255,.08);box-shadow:inset 0 0 0 2px var(--white)}\n\n  /* Header */\n  header{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.92);backdrop-filter:blur(10px);border-bottom:1px solid var(--gray-200)}\n  .nav{display:flex;align-items:center;justify-content:space-between;height:72px}\n  .nav img{height:40px;width:auto}\n  .nav-phone{display:flex;align-items:center;gap:10px;font-weight:700;text-decoration:none;color:var(--gray-700)}\n  .nav-phone span{direction:ltr}\n  .nav-phone .ico{width:38px;height:38px;border-radius:50%;background:var(--orange-soft);display:grid;place-items:center;color:var(--orange-dark)}\n\n  /* Hero */\n  .hero{position:relative;background:linear-gradient(160deg,#3a3a3a 0%,var(--gray-900) 60%,#1f1f1f 100%);color:var(--white);overflow:hidden}\n  .hero::before{content:\"\";position:absolute;width:620px;height:620px;border-radius:50%;background:radial-gradient(circle,rgba(242,159,5,.35),transparent 65%);top:-220px;left:-180px}\n  .hero::after{content:\"\";position:absolute;inset:0;background-image:radial-gradient(rgba(255,255,255,.06) 1px,transparent 1px);background-size:22px 22px;pointer-events:none}\n  .hero-grid{position:relative;z-index:1;display:grid;grid-template-columns:1.1fr .9fr;gap:56px;align-items:center;padding:80px 0 96px}\n  .badge{display:inline-flex;align-items:center;gap:8px;background:rgba(242,159,5,.15);color:var(--orange);border:1px solid rgba(242,159,5,.35);\n         padding:6px 14px;border-radius:999px;font-weight:700;font-size:.9rem;margin-bottom:22px}\n  .badge::before{content:\"\";width:8px;height:8px;border-radius:50%;background:var(--orange);box-shadow:0 0 0 4px rgba(242,159,5,.25)}\n  .hero h1{font-size:clamp(2.1rem,4.6vw,3.6rem);line-height:1.12;font-weight:900;letter-spacing:-.5px;margin-bottom:20px}\n  .hero h1 .hl{position:relative;color:var(--orange);white-space:nowrap}\n  .hero h1 .hl::after{content:\"\";position:absolute;right:0;left:0;bottom:4px;height:10px;background:rgba(242,159,5,.25);border-radius:6px;z-index:-1}\n  .hero p.lead{font-size:1.2rem;color:#d6d6d6;max-width:540px;margin-bottom:28px}\n  .checks{list-style:none;display:grid;gap:12px;margin-bottom:34px}\n  .checks li{display:flex;align-items:center;gap:12px;font-weight:500}\n  .checks li::before{content:\"✓\";flex:none;width:26px;height:26px;border-radius:50%;background:var(--orange);color:var(--gray-900);display:grid;place-items:center;font-weight:900;font-size:.85rem}\n  .hero-ctas{display:flex;flex-wrap:wrap;gap:14px}\n\n  /* Form card */\n  .form-card{background:var(--white);color:var(--gray-900);border-radius:24px;padding:34px 30px;box-shadow:0 30px 80px rgba(0,0,0,.35);position:relative}\n  .form-card::before{content:\"\";position:absolute;top:-1px;right:30px;left:30px;height:5px;background:var(--orange);border-radius:0 0 6px 6px}\n  .form-card h2{font-size:1.6rem;font-weight:800;line-height:1.25;margin-bottom:6px}\n  .form-card .sub{color:var(--gray-500);margin-bottom:22px;font-size:.98rem}\n  .field{margin-bottom:14px}\n  .field label{display:block;font-weight:600;font-size:.92rem;margin-bottom:6px;color:var(--gray-700)}\n  .field input,.field select{width:100%;font:inherit;padding:13px 16px;border:1.5px solid var(--gray-200);border-radius:12px;background:var(--gray-100);color:var(--gray-900);transition:border-color .15s,background .15s}\n  .field input:focus,.field select:focus{border-color:var(--orange);background:var(--white);outline:none}\n  .field input[type=tel]{direction:rtl;text-align:right}\n  .form-card .btn{width:100%;margin-top:6px;padding:17px}\n  .privacy{font-size:.8rem;color:var(--gray-500);text-align:center;margin-top:12px}\n  .hp{position:absolute;width:1px;height:1px;opacity:0;overflow:hidden;clip-path:inset(50%);pointer-events:none}\n  .error{color:#c0392b;font-size:.85rem;margin-top:4px;display:none}\n  .field.invalid input{border-color:#c0392b}\n  .field.invalid .error{display:block}\n  .thanks{display:none;text-align:center;padding:30px 0}\n  .thanks .big{width:72px;height:72px;margin:0 auto 18px;border-radius:50%;background:var(--orange);display:grid;place-items:center;font-size:2rem;font-weight:900}\n  .thanks h3{font-size:1.5rem;margin-bottom:8px}\n  .sent .form-body{display:none}\n  .sent .thanks{display:block}\n\n  /* Stats */\n  .stats{background:var(--orange)}\n  .stats .wrap{display:grid;grid-template-columns:repeat(5,1fr);gap:16px;padding:34px 0}\n  .stat{text-align:center;color:var(--gray-900)}\n  .stat b{display:block;font-size:clamp(1.8rem,3.4vw,2.6rem);font-weight:900;line-height:1.1}\n  .stat span{font-weight:600;font-size:.95rem}\n\n  /* Sections */\n  section{padding:96px 0}\n  .eyebrow{color:var(--orange-dark);font-weight:800;letter-spacing:.5px;margin-bottom:10px;display:block}\n  .sec-title{font-size:clamp(1.9rem,3.6vw,2.7rem);font-weight:900;line-height:1.2;margin-bottom:14px}\n  .sec-sub{color:var(--gray-500);max-width:640px;font-size:1.1rem}\n  .sec-head{margin-bottom:52px}\n  .center{text-align:center}\n  .center .sec-sub{margin-inline:auto}\n\n  /* Pain */\n  .pain{background:var(--gray-100)}\n  .pain-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}\n  .pain-card{background:var(--white);border-radius:var(--radius);padding:28px;border-right:5px solid var(--gray-700)}\n  .pain-card h3{font-size:1.15rem;margin-bottom:8px}\n  .pain-card p{color:var(--gray-500)}\n  .pain-answer{margin-top:40px;text-align:center;font-size:1.3rem;font-weight:700}\n\n  /* Services */\n  .services-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}\n  .svc{border:1.5px solid var(--gray-200);border-radius:var(--radius);padding:30px;transition:transform .2s,box-shadow .2s,border-color .2s;background:var(--white)}\n  .svc:hover{transform:translateY(-6px);box-shadow:var(--shadow);border-color:var(--orange)}\n  .svc .ic{width:56px;height:56px;border-radius:16px;background:var(--orange-soft);color:var(--orange-dark);display:grid;place-items:center;margin-bottom:18px}\n  .svc .ic svg{width:28px;height:28px}\n  .svc h3{font-size:1.2rem;margin-bottom:8px}\n  .svc p{color:var(--gray-500)}\n\n  /* Process */\n  .process{background:var(--gray-900);color:var(--white)}\n  .process .sec-sub{color:#bdbdbd}\n  .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:26px;counter-reset:step}\n  .step{background:#353535;border-radius:var(--radius);padding:34px 28px;position:relative;border:1px solid #444}\n  .step .num{font-size:3.2rem;font-weight:900;color:var(--orange);line-height:1;margin-bottom:14px}\n  .step h3{font-size:1.25rem;margin-bottom:10px}\n  .step p{color:#c9c9c9}\n\n  /* Why */\n  .why-grid{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}\n  .why-list{display:grid;gap:22px}\n  .why-item{display:flex;gap:16px}\n  .why-item .dot{flex:none;width:46px;height:46px;border-radius:14px;background:var(--orange);display:grid;place-items:center;font-weight:900;color:var(--gray-900)}\n  .why-item h3{font-size:1.15rem;margin-bottom:4px}\n  .why-item p{color:var(--gray-500)}\n  .quote-box{background:var(--gray-100);border-radius:28px;padding:44px;position:relative}\n  .quote-box::before{content:\"”\";position:absolute;top:-10px;right:30px;font-size:8rem;line-height:1;color:var(--orange);font-weight:900}\n  .quote-box p{font-size:1.4rem;font-weight:700;line-height:1.5;margin-top:30px}\n  .quote-box small{display:block;margin-top:16px;color:var(--gray-500);font-size:1rem}\n\n  /* Testimonials */\n  .testi{background:var(--gray-100)}\n  .testi-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}\n  .t-card{background:var(--white);border-radius:var(--radius);padding:30px;display:flex;flex-direction:column;gap:18px;box-shadow:0 6px 20px rgba(0,0,0,.04)}\n  .stars{color:var(--orange);letter-spacing:3px;font-size:1.1rem}\n  .t-card blockquote{flex:1;color:var(--gray-700)}\n  .t-who{display:flex;align-items:center;gap:12px}\n  .avatar{width:44px;height:44px;border-radius:50%;background:var(--gray-700);color:var(--white);display:grid;place-items:center;font-weight:800}\n  .t-who b{display:block;line-height:1.2}\n  .t-who span{font-size:.88rem;color:var(--gray-500)}\n\n  /* FAQ */\n  .faq-list{max-width:820px;margin-inline:auto;display:grid;gap:12px}\n  details{border:1.5px solid var(--gray-200);border-radius:14px;background:var(--white);transition:border-color .2s}\n  details[open]{border-color:var(--orange)}\n  summary{list-style:none;cursor:pointer;padding:20px 24px;font-weight:700;font-size:1.08rem;display:flex;justify-content:space-between;align-items:center;gap:16px}\n  summary::-webkit-details-marker{display:none}\n  summary::after{content:\"+\";flex:none;width:30px;height:30px;border-radius:50%;background:var(--orange-soft);color:var(--orange-dark);display:grid;place-items:center;font-size:1.3rem;transition:transform .2s}\n  details[open] summary::after{transform:rotate(45deg);background:var(--orange);color:var(--gray-900)}\n  details p{padding:0 24px 22px;color:var(--gray-500)}\n\n  /* Final CTA */\n  .final{background:linear-gradient(135deg,var(--orange) 0%,#f7b733 100%);padding:80px 0}\n  .final-grid{display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:center}\n  .final h2{font-size:clamp(2rem,3.8vw,2.9rem);font-weight:900;line-height:1.15;margin-bottom:14px}\n  .final p{font-size:1.15rem;font-weight:500;color:#3b2a00}\n  .final .form-card{box-shadow:0 30px 70px rgba(120,70,0,.3)}\n  .final .form-card::before{background:var(--gray-900)}\n\n  footer{background:var(--gray-900);color:#aaa;padding:36px 0;font-size:.92rem}\n  footer .wrap{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:16px}\n  footer a{text-decoration:none;color:#ddd}\n  footer a:hover{color:var(--orange)}\n  .socials{display:flex;gap:18px}\n\n  /* Floating mobile bar */\n  .mobile-bar{display:none}\n\n  /* Reveal */\n  .reveal{opacity:0;transform:translateY(24px);transition:opacity .6s ease,transform .6s ease}\n  .reveal.in{opacity:1;transform:none}\n  @media (prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none;transition:none}html{scroll-behavior:auto}}\n\n  @media (max-width:960px){\n    .hero-grid,.why-grid,.final-grid{grid-template-columns:1fr;gap:40px}\n    .hero-grid{padding:56px 0 72px}\n    .services-grid,.pain-grid,.testi-grid,.steps{grid-template-columns:1fr 1fr}\n    .stats .wrap{grid-template-columns:repeat(3,1fr)}\n  }\n  @media (max-width:640px){\n    body{font-size:16px;padding-bottom:70px}\n    section{padding:68px 0}\n    .services-grid,.pain-grid,.testi-grid,.steps{grid-template-columns:1fr}\n    .stats .wrap{grid-template-columns:1fr 1fr}\n    .stats .stat:last-child{grid-column:1/-1}\n    .nav-phone span{display:none}\n    .hero h1 .hl{white-space:normal}\n    .form-card{padding:28px 20px}\n    .quote-box{padding:34px 26px}\n    .mobile-bar{display:grid;grid-template-columns:1fr 1fr;gap:10px;position:fixed;bottom:0;right:0;left:0;z-index:60;padding:10px 16px;background:var(--white);box-shadow:0 -6px 20px rgba(0,0,0,.1)}\n    .mobile-bar a{padding:13px;font-size:1rem}\n    .mobile-bar .wa{background:var(--gray-900);color:var(--white);box-shadow:none}\n  }\n</style>\n\n\n<header>\n  <div class=\"wrap nav\">\n    <a href=\"#top\" aria-label=\"קליקינג – לראש הדף\"><img src=\"https://clicking.co.il/wp-content/uploads/elementor/thumbs/cropped-%D7%A7%D7%9C%D7%99%D7%A7%D7%99%D7%A0%D7%92-%D7%9C%D7%95%D7%92%D7%95-1-ri7t6k8xmzta1pvdtue715snddxbgxr8kiq4wxys6y.png\" alt=\"קליקינג\" width=\"200\" height=\"57\"></a>\n    <a class=\"nav-phone\" href=\"tel:0549700096\" aria-label=\"התקשרו אלינו 054-9700096\">\n      <span>054-9700096</span>\n      <span class=\"ico\" aria-hidden=\"true\">\n        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z\"/></svg>\n      </span>\n    </a>\n  </div>\n</header>\n\n<main id=\"top\">\n  <!-- HERO -->\n  <div class=\"hero\">\n    <div class=\"wrap hero-grid\">\n      <div>\n        <span class=\"badge\">12+ שנות ניסיון בשיווק דיגיטלי</span>\n        <h1>הפרסום שלכם עובד קשה,<br>אבל <span class=\"hl\">הלקוחות</span> לא מגיעים?</h1>\n        <p class=\"lead\">בקליקינג אנחנו בונים ומנהלים קמפיינים בגוגל, פייסבוק ואינסטגרם, שהמטרה שלהם אחת: להביא לעסק שלכם לידים איכותיים ומכירות. לא רק לייקים.</p>\n        <ul class=\"checks\">\n          <li>פגישת אפיון ואסטרטגיה ללא עלות, גם בזום</li>\n          <li>שקיפות מלאה בתקציב ובנתונים, עם גישה למערכות הפרסום</li>\n          <li>מנהל קמפיין אישי וזמינות גבוהה בווטסאפ ובטלפון</li>\n        </ul>\n        <div class=\"hero-ctas\">\n          <a href=\"#lead\" class=\"btn\">לקבלת פגישת ייעוץ חינם ←</a>\n          <a href=\"#process\" class=\"btn btn-ghost\">איך זה עובד?</a>\n        </div>\n      </div>\n\n      <div class=\"form-card\" id=\"lead\">\n        <div class=\"form-body\">\n          <h2>בואו נדבר על <span class=\"accent\">הצמיחה</span> של העסק שלכם</h2>\n          <p class=\"sub\">השאירו פרטים ונחזור אליכם תוך יום עסקים אחד.</p>\n          <form class=\"lead-form\" novalidate>\n            <input class=\"hp\" type=\"text\" name=\"company_site\" tabindex=\"-1\" autocomplete=\"off\" aria-hidden=\"true\">\n            <div class=\"field\">\n              <label for=\"name1\">שם מלא</label>\n              <input id=\"name1\" name=\"name\" type=\"text\" autocomplete=\"name\" required placeholder=\"איך קוראים לך?\">\n              <div class=\"error\">נא למלא שם</div>\n            </div>\n            <div class=\"field\">\n              <label for=\"phone1\">טלפון</label>\n              <input id=\"phone1\" name=\"phone\" type=\"tel\" inputmode=\"tel\" autocomplete=\"tel\" required placeholder=\"050-0000000\">\n              <div class=\"error\">נא למלא מספר טלפון תקין</div>\n            </div>\n            <div class=\"field\">\n              <label for=\"biz1\">תחום העסק</label>\n              <input id=\"biz1\" name=\"business\" type=\"text\" placeholder=\"לדוגמה: קליניקה, נדל״ן, חנות אונליין\">\n            </div>\n            <div class=\"field\">\n              <label for=\"int1\">מה הכי מעניין אותך?</label>\n              <select id=\"int1\" name=\"interest\">\n                <option>עוד לא בטוח/ה, רוצה ייעוץ</option>\n                <option>קמפיינים בגוגל</option>\n                <option>קמפיינים בפייסבוק ואינסטגרם</option>\n                <option>דף נחיתה / אתר</option>\n                <option>קידום אורגני SEO</option>\n                <option>ניהול רשתות חברתיות</option>\n                <option>וידאו וסרטוני תדמית</option>\n              </select>\n            </div>\n            <button class=\"btn\" type=\"submit\">אני רוצה פגישת ייעוץ חינם</button>\n            <p class=\"privacy\">🔒 הפרטים שלך נשמרים אצלנו בלבד. בלי ספאם.</p>\n          </form>\n        </div>\n        <div class=\"thanks\" role=\"status\" aria-live=\"polite\">\n          <div class=\"big\">✓</div>\n          <h3>תודה, קיבלנו!</h3>\n          <p>נחזור אליך בהקדם. אם בא לך לדבר כבר עכשיו: <a href=\"tel:0549700096\">054-9700096</a></p>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- STATS -->\n  <div class=\"stats\" aria-label=\"קליקינג במספרים\">\n    <div class=\"wrap\">\n      <div class=\"stat\"><b data-count=\"12\">12</b><span>שנות פעילות</span></div>\n      <div class=\"stat\"><b data-count=\"300\">300</b><span>דפים עסקיים מנוהלים</span></div>\n      <div class=\"stat\"><b data-count=\"2500\">2,500</b><span>קמפיינים בפייסבוק</span></div>\n      <div class=\"stat\"><b data-count=\"1854\">1,854</b><span>קמפיינים בגוגל</span></div>\n      <div class=\"stat\"><b data-count=\"3000\">3,000</b><span>לידים מדי חודש</span></div>\n    </div>\n  </div>\n\n  <!-- PAIN -->\n  <section class=\"pain\">\n    <div class=\"wrap\">\n      <div class=\"sec-head center reveal\">\n        <span class=\"eyebrow\